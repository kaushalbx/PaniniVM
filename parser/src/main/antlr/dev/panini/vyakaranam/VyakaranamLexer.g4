TUMUN   : 'तुमुन्';
NAMUL   : 'णमुल्';
KASUN   : 'कसुन्';
KTVOS   : 'क्त्वोस्';

// ============================================================================
// तद्धितप्रत्ययाः
// ============================================================================

MATUP           : 'मतुप्';
VATUP           : 'वतुप्';
INI             : 'इनि';
TVA             : 'त्व';
TAL             : 'तल्';
TARAP           : 'तरप्';
TAMAP           : 'तमप्';
MAYAT           : 'मयट्';
