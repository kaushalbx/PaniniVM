DHAA         : 'धा';

// ============================================================================
// स्त्रीप्रत्ययाः
// ============================================================================

TAAP    : 'टाप्';
DAAP    : 'डाप्';
CHAAP   : 'चाप्';
NEEP    : 'ङीप्';
NEESH   : 'ङीष्';
NEEN    : 'ङीन्';
UUNG    : 'ऊङ्';
