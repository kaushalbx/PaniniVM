SUP_SU      : 'सुँ';
SUP_AU      : 'औ';
SUP_JAS     : 'जस्';
SUP_AM      : 'अम्';
SUP_AUT     : 'औट्';
SUP_SHAS    : 'शस्';
SUP_TA      : 'टा';
SUP_BHYAM   : 'भ्याम्';
SUP_BHIS    : 'भिस्';
SUP_NGE     : 'ङे';
SUP_BHYAS   : 'भ्यस्';
SUP_NGASI   : 'ङसिँ';
SUP_NGAS    : 'ङस्';
SUP_OS      : 'ओस्';
SUP_AAM     : 'आम्';
SUP_NGI     : 'ङि';
SUP_SUP     : 'सुप्';

// ============================================================================
// विकरणाः
// ============================================================================

SHAP            : 'शप्';
SHYAN           : 'श्यन्';
SHNU            : 'श्नु';
SHNAM           : 'श्नम्';
SHNA            : 'श्ना';
U_VIKARANA      : 'उ';
SHNAAM          : 'श्नाम्';
YAK             : 'यक्';
SHAH            : 'शः';
SYA             : 'स्य';
TAS_VIKARANA    : 'तास्';
CLI             : 'च्लि';
SIC             : 'सिच्';
ANG             : 'अङ्';
CHANG           : 'चङ्';
KSA             : 'क्स';

// ============================================================================
// आगमाः
// ============================================================================

AT          : 'अट्';
IIT_AGAMA   : 'ईट्';
NUM         : 'नुम्';
