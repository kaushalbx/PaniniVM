lexer grammar VyakaranamLexer;

@header {
package dev.panini.parser;
}

// ============================================================================
// संरचनाचिह्नानि
// ============================================================================

PLUS
    : '+'
    ;

SAMASA_SEPARATOR
    : '-'
    | '—'
    ;

COMMA
    : ','
    | '\u060C'
    ;

DANDA
    : '।'
    | '॥'
    | '.'
    ;

LPAREN
    : '('
    ;

RPAREN
    : ')'
    ;

// ============================================================================
// सम्बोधनसूचकाः
// ============================================================================

HE      : 'हे';
BHOH    : 'भोः';

// ============================================================================
// अव्ययानि तथा वाक्यसम्बन्धकाः
// ============================================================================

CHA         : 'च';
VAA         : 'वा';
ATHA        : 'अथ';
TATAH       : 'ततः';
ANANTARAM   : 'अनन्तरम्';
KINTU       : 'किन्तु';
ATAH        : 'अतः';
YATAH       : 'यतः';
MAA         : 'मा';
NA          : 'न';
ITI         : 'इति';
API         : 'अपि';
EVA         : 'एव';
TU_AVYAYA   : 'तु';
HI          : 'हि';
KHALU       : 'खलु';
NANU        : 'ननु';
YATHA       : 'यथा';
TATHA       : 'तथा';
YADA        : 'यदा';
TADA        : 'तदा';
YATRA       : 'यत्र';
TATRA       : 'तत्र';
KADA        : 'कदा';
KUTRA       : 'कुत्र';
SARVATRA    : 'सर्वत्र';
KATHAM      : 'कथम्';
KUTAH       : 'कुतः';
KRPAYA      : 'कृपया';
SAHASAA     : 'सहसा';
SHANAIH     : 'शनैः';
PUNAH       : 'पुनः';
NYUNATAYA   : 'न्यूनतया';
ADYA        : 'अद्य';
SHVAH       : 'श्वः';
HYAH        : 'ह्यः';

// ============================================================================
// संख्याव्ययानि (Numeral Avyayas & Modifiers)
// ============================================================================

ADHIKA          : 'अधिक' | 'अभ्यधिक' ;
UNA             : 'ऊन' | 'न्यून' ;
SAKRIT          : 'सकृत्' ;
DVIH            : 'द्विः' ;
TRIH            : 'त्रिः' ;
CHATUH          : 'चतुः' ;
KRITVAS         : 'कृत्वस्' | 'कृत्वः' ;

INTERJECTION
    : 'अहो'
    | 'बत'
    | 'धिक्'
    | 'हन्त'
    | 'स्वस्ति'
    | 'नमस्ते'
    ;

// ============================================================================
// उपसर्गाः
// ============================================================================

PRA             : 'प्र';
PARAA           : 'परा';
SAM             : 'सम्';
ANUU            : 'अनु';
AVA             : 'अव';
NIS             : 'निस्';
DUS             : 'दुस्';
VI              : 'वि';
AANG            : 'आङ्';
NI              : 'नि';
ADHI            : 'अधि';
ATI             : 'अति';
SU              : 'सु';
UD              : 'उद्';
ABHI            : 'अभि';
PRATI           : 'प्रति';
PARI            : 'परि';
UPA             : 'उप';

// ============================================================================
// सन्नादयः
// ============================================================================

SAN     : 'सन्';
KYACH   : 'क्यच्';
KAAMYACH: 'काम्यच्';
KYANG   : 'क्यङ्';
KYASH   : 'क्यष्';
NIC     : 'णिच्';
