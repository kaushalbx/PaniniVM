LRNG    : 'लृङ्';

// ============================================================================
// तिङ्प्रत्ययाः
// ============================================================================

TIP     : 'तिप्';
TAS     : 'तस्';
JHI     : 'झि';
SIP     : 'सिप्';
THAS    : 'थस्';
THA     : 'थ';
MIP     : 'मिप्';
VAS     : 'वस्';
