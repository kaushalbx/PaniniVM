ANIYAR      : 'अनीयर्';
YAT         : 'यत्';
NYAT        : 'ण्यत्';
KYAP        : 'क्यप्';
SHATR       : 'शतृ';
SHANACH     : 'शानच्';
GHANJ       : 'घञ्';
LYUT        : 'ल्युट्';
NVUL        : 'ण्वुल्';
TRICH       : 'तृच्';
ANIN        : 'अनिन्';
KHAL        : 'खल्';
KWIP        : 'क्विप्';
KTIN        : 'क्तिन्';
AC          : 'अच्';
AP          : 'अप्';
KA          : 'क';
