// ============================================================================
// सुपो लोपावस्थाः
// ============================================================================

LUK     : 'लुक्';
SHLU    : 'श्लु';
LUP     : 'लुप्';
ALUK    : 'अलुक्';

// ============================================================================
// व्युत्पत्तिचिह्नानि
// ============================================================================

ABHYASA : 'अभ्यासः';
ADESHA  : 'आदेशः';
UNADI   : 'उणादि';

// ============================================================================
// सामान्यपरिचायकः
// ============================================================================

/*
 * This rule must remain after all specific grammatical tokens.
 *
 * Therefore:
 *
 * लट्  → LAT
 * तिप् → TIP
 * सुँ  → SUP_SU
 * राम  → IDENTIFIER
 * खाद् → IDENTIFIER
 */
// ============================================================================
// नियन्त्रण-सङ्केताः (Control Flow Keywords)
// ============================================================================

YADI        : 'यदि';
TARHI       : 'तर्हि';
ANYATHA     : 'अन्यथा';
YAVAT       : 'यावत्';
TAVAT       : 'तावत्';

IDENTIFIER
    : IDENTIFIER_START IDENTIFIER_PART*
    ;

fragment IDENTIFIER_START
    : [a-zA-Z]
    | [\u0900-\u097F]
    ;

fragment IDENTIFIER_PART
    : [a-zA-Z0-9_]
    | [\u0900-\u097F]
    | [\u0300-\u036F]
    ;

// ============================================================================
// रिक्तस्थानम्
// ============================================================================

WS
    : [ \t\r\n]+ -> skip
    ;
