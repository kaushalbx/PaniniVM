<idea-plugin>
    <id>dev.panini.idea-plugin</id>
    <name>PaniniVM Language Support</name>
    <version>0.1.0</version>
    <vendor email="support@panini.dev" url="https://github.com/kaushalbx/PaniniVM">Pāṇini Team</vendor>
    <!-- PaniniVM targets JVM 21; IntelliJ Platform branch 242 is the first JVM 21 baseline. -->
    <idea-version since-build="242"/>

    <description><![CDATA[
      JetBrains IntelliJ IDEA plugin for PaniniVM (.pvm) Sanskrit programming script files.
      Features include file type recognition, custom file icons, AST parsing, syntax highlighting, autocompletion, live error annotations, quick documentation popups, code commenter, structure view, and live script execution run configurations.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="PaniniVM"
                implementationClass="dev.panini.plugin.PvmFileType"
                fieldName="INSTANCE"
                language="PaniniVM"
                extensions="pvm"/>
        <fileBasedIndex
                implementation="dev.panini.plugin.PvmPrakriyaIndex"/>
        <lang.parserDefinition
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="dev.panini.plugin.PvmColorSettingsPage"/>
        <completion.contributor
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmCompletionContributor"/>
        <lang.parameterInfo
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmParameterInfoHandler"/>
        <annotator
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmAnnotator"/>
        <psi.structureViewFactory
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmStructureViewFactory"/>
        <lang.documentationProvider
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmDocumentationProvider"/>
        <gotoDeclarationHandler
                implementation="dev.panini.plugin.PvmGotoDeclarationHandler"/>
        <psi.referenceContributor
                language="PaniniVM"
                implementation="dev.panini.plugin.PvmReferenceContributor"/>
        <lang.findUsagesProvider
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmFindUsagesProvider"/>
        <lang.commenter
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmCommenter"/>
        <lang.pairedBraceMatcher
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmPairedBraceMatcher"/>
        <lang.foldingBuilder
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmFoldingBuilder"/>
        <lang.formatter
                language="PaniniVM"
                implementationClass="dev.panini.plugin.PvmFormattingModelBuilder"/>
        <breadcrumbsInfoProvider
                implementation="dev.panini.plugin.PvmBreadcrumbsProvider"/>
        <configurationType
                implementation="dev.panini.plugin.run.PvmRunConfigurationType"/>
        <runConfigurationProducer
                implementation="dev.panini.plugin.run.PvmRunConfigurationProducer"/>
        <runLineMarkerContributor
                language="PaniniVM"
                implementationClass="dev.panini.plugin.run.PvmRunLineMarkerContributor"/>
        <editorFactoryListener
                implementation="dev.panini.plugin.PvmEditorInlayListener"/>
        <intentionAction>
            <className>dev.panini.plugin.PvmConvertToKatapayadiIntention</className>
            <category>PaniniVM</category>
        </intentionAction>
        <intentionAction>
            <className>dev.panini.plugin.PvmConvertToBhutasamkhyaIntention</className>
            <category>PaniniVM</category>
        </intentionAction>
        <intentionAction>
            <className>dev.panini.plugin.PvmConvertToDecimalIntention</className>
            <category>PaniniVM</category>
        </intentionAction>
    </extensions>
</idea-plugin>
