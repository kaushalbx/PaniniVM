# Constructive universality witness: a finite program for a two-counter machine.
#
# अवस्था is the program counter, सङ्ख्या is C1, and योग is C2. The named
# operations below are machine instructions. Conditional dispatch selects the
# next instruction, while the unbounded यावत् loop supplies repeated execution.

# INC(C2); goto instruction 2.
वृध् + ल्युट् + सुँ इति प्रक्रिया + सुँ असँ + लट् + तिप् ।
योग + अम् एक + अम् च युज् + णिच् + लोट् + सिप्
    ततः फल + अम् योग + ङि स्था + णिच् + लोट् + सिप् ।
द्वि + औट् अवस्था + ङि स्था + णिच् + लोट् + सिप् ॥

# DEC(C1); goto instruction 1.
हृ + ल्युट् + सुँ इति प्रक्रिया + सुँ असँ + लट् + तिप् ।
सङ्ख्या + अम् एक + अम् च वि + युज् + णिच् + लोट् + सिप्
    ततः फल + अम् सङ्ख्या + ङि स्था + णिच् + लोट् + सिप् ।
एक + अम् अवस्था + ङि स्था + णिच् + लोट् + सिप् ॥

# HALT: program counter := 0.
स्था + ल्युट् + सुँ इति प्रक्रिया + सुँ असँ + लट् + तिप् ।
शून्य + अम् अवस्था + ङि स्था + णिच् + लोट् + सिप् ॥

# Instruction 2: if C1 > 0 then DEC(C1), otherwise HALT.
चर् + ल्युट् + सुँ इति प्रक्रिया + सुँ असँ + लट् + तिप् ।
यदि शून्य + सुँ सङ्ख्या + ङसिँ न्यून + सुँ असँ + लट् + तिप् तर्हि हृ + ल्युट् + टा डुकृञ् + उ + लोट् + सिप् अन्यथा स्था + ल्युट् + टा डुकृञ् + उ + लोट् + सिप् ॥

# Dispatcher: PC > 1 selects instruction 2; otherwise instruction 1.
दिश् + ल्युट् + सुँ इति प्रक्रिया + सुँ असँ + लट् + तिप् ।
यदि एक + सुँ अवस्था + ङसिँ न्यून + सुँ असँ + लट् + तिप् तर्हि चर् + ल्युट् + टा डुकृञ् + उ + लोट् + सिप् अन्यथा वृध् + ल्युट् + टा डुकृञ् + उ + लोट् + सिप् ॥

# Initial machine configuration: PC=2, C1=3, C2=0.
द्वि + औट् अवस्था + ङि स्था + णिच् + लोट् + सिप् ।
त्रि + शस् सङ्ख्या + ङि स्था + णिच् + लोट् + सिप् ।
शून्य + अम् योग + ङि स्था + णिच् + लोट् + सिप् ।

# Execute until HALT, then observe C2 = 3.
यावत् शून्य + सुँ अवस्था + ङसिँ न्यून + सुँ असँ + लट् + तिप् तावत् दिश् + ल्युट् + टा डुकृञ् + उ + लोट् + सिप् ।
मुद्र् + णिच् + लोट् + सिप् योग + अम् ।
